R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=SPECTRA
VERSION=0.1.72
LANGUAGE=Zig
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=console
TARGET=/R4OS/SOFTWARE/TERMINAL/DIAG/SPECTRA.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query:1
IMPORT=R4DEV:Query:1
IMPORT=R4DESK:Query:1
IMPORT=R4DRAW:Query:1
IMPORT=R4AUDIO:Query:1
IMPORT=R4NET:Query:1
IMPORT=EXTMATH:API_V1:1:1
